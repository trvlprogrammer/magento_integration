<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/odoo-integration/shipping-methods" method="GET">
        <service class="Trvlprogrammer\Integration\Api\ShippingMethodManagementInterface"
                 method="getList"/>
        <resources>
            <resource ref="Trvlprogrammer_Integration::methods"/>
        </resources>
    </route>
    <route url="/V1/odoo-integration/payment-methods" method="GET">
        <service class="Trvlprogrammer\Integration\Api\PaymentMethodManagementInterface"
                 method="getList"/>
        <resources>
            <resource ref="Trvlprogrammer_Integration::methods"/>
        </resources>
    </route>
</routes>
